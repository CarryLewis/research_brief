# Thinking Vault — Notion → Obsidian (GitHub Actions)
#
# For scheduled sync, set these as GitHub Actions repository secrets:
#   Settings → Secrets and variables → Actions
NOTION_TOKEN=
NOTION_THINKING_DATABASE_ID=

# Repo-relative paths (used locally if you run the CLI for debugging)
THINKING_VAULT_PATH=vault
THINKING_NOTES_FOLDER=Thinking
THINKING_ARCHIVE_FOLDER=Archive/Thinking
DATA_DIR=state
