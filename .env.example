# LLM (OpenAI-compatible or Anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional PubMed (higher rate limits with email/tool)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# Optional Email IMAP (pull; optional supplement — push webhook is the primary ingress)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Inbound email webhook (push)
# Required for POST /api/inbound/email — send as Bearer token, X-Inbound-Secret, or ?secret=
INBOUND_WEBHOOK_SECRET=change-me
# Optional: pin to an existing notebook id; otherwise auto-creates topic 订阅收件
INBOUND_NOTEBOOK_ID=
INBOUND_MAX_LINKS=3
INBOUND_TOPIC=订阅收件
# open = 接受所有发件人（匹配目录则打标签）；allowlist = 仅接受已启用的订阅目录
SUBSCRIPTION_MODE=open

# Digest → 主邮箱（日/周快报）
DIGEST_TO=you@main-email.com
DIGEST_FROM=
DIGEST_LANGUAGE=zh
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# App
DATA_DIR=./data
# Immutable Content Lake (raw originals / media). Defaults to DATA_DIR/content_lake
CONTENT_LAKE_DIR=
DEFAULT_VAULT_PATH=/Users/carrylewis/Library/Mobile Documents/iCloud~md~obsidian/Documents/检索信息库
# Shared token for browser extension → POST /api/library/save (Bearer or X-Library-Token).
# Leave empty to allow unauthenticated local saves during development.
LIBRARY_API_TOKEN=
HOST=127.0.0.1
PORT=8000
