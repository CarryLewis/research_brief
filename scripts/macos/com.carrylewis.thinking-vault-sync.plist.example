<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent — Notion Thinking DB → iCloud Obsidian vault (direct).

  Prerequisites:
    1. Clone: ~/Documents/research_brief
    2. Create ~/Documents/research_brief/.env with:
         NOTION_TOKEN=ntn_...
         NOTION_THINKING_DATABASE_ID=51e7fdfd-46f8-4d85-a813-f68b56131615
    3. Confirm OBSIDIAN_VAULT below matches Obsidian → Manage vaults
    4. Install:
         chmod +x ~/Documents/research_brief/scripts/sync-to-local-obsidian.sh
         mkdir -p ~/Library/LaunchAgents
         cp ~/Documents/research_brief/scripts/macos/com.carrylewis.thinking-vault-sync.plist.example \
            ~/Library/LaunchAgents/com.carrylewis.thinking-vault-sync.plist
         # edit OBSIDIAN_VAULT in the copied plist if needed
         launchctl bootout gui/$(id -u)/com.carrylewis.thinking-vault-sync 2>/dev/null || true
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.carrylewis.thinking-vault-sync.plist
         launchctl kickstart -k gui/$(id -u)/com.carrylewis.thinking-vault-sync

  Logs: ~/Library/Logs/thinking-vault-sync.log
  Interval: 900s (15 min)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carrylewis.thinking-vault-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/carrylewis/Documents/research_brief/scripts/sync-to-local-obsidian.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RESEARCH_BRIEF_REPO</key>
    <string>/Users/carrylewis/Documents/research_brief</string>
    <!-- Exact path from Obsidian → Manage vaults for "Thinking valut" -->
    <key>OBSIDIAN_VAULT</key>
    <string>/Users/carrylewis/Library/Mobile Documents/iCloud~md~obsidian/Documents</string>
    <!-- Proxy is auto-detected by the script (Clash 7890 if listening). -->
    <key>THINKING_PROXY_HOST</key>
    <string>127.0.0.1</string>
    <key>THINKING_PROXY_PORT</key>
    <string>7890</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/carrylewis/Library/Logs/thinking-vault-sync.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/carrylewis/Library/Logs/thinking-vault-sync.launchd.err.log</string>
</dict>
</plist>
